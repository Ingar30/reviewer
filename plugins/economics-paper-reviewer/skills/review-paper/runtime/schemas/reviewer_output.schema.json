{
  "$defs": {
    "typed_numeric_check": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "arithmetic"
              ]
            },
            "operation": {
              "type": "string",
              "maxLength": 64
            },
            "quantities": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/quantity"
              },
              "minItems": 1
            },
            "reported": {
              "$ref": "#/$defs/quantity"
            },
            "computed_value": {
              "type": "string",
              "minLength": 1
            },
            "tolerance": {
              "type": "string",
              "minLength": 1
            },
            "observed_discrepancy": {
              "type": "string",
              "minLength": 1
            },
            "possible_explanation": {
              "type": "string",
              "minLength": 1
            },
            "suggested_correction": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "operation",
            "quantities",
            "reported",
            "computed_value",
            "tolerance",
            "observed_discrepancy",
            "possible_explanation",
            "suggested_correction"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "cross_source"
              ]
            },
            "quantities": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/quantity"
              },
              "minItems": 2
            },
            "comparability": {
              "type": "string",
              "minLength": 1
            },
            "observed_discrepancy": {
              "type": "string",
              "minLength": 1
            },
            "possible_explanation": {
              "type": "string",
              "minLength": 1
            },
            "suggested_correction": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "quantities",
            "comparability",
            "observed_discrepancy",
            "possible_explanation",
            "suggested_correction"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "underdetermined"
              ]
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "quantities": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/quantity"
              }
            },
            "missing_information": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "status": {
              "type": "string",
              "enum": [
                "unresolved"
              ]
            }
          },
          "required": [
            "kind",
            "question",
            "quantities",
            "missing_information",
            "status"
          ],
          "additionalProperties": false
        }
      ]
    },
    "quantity": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "sample": {
          "type": "string",
          "minLength": 1
        },
        "denominator": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "rounding_half_width": {
          "type": "string",
          "minLength": 1
        },
        "scale": {
          "type": "string",
          "enum": [
            "number",
            "proportion",
            "percent"
          ]
        }
      },
      "required": [
        "value",
        "source_id",
        "unit",
        "sample",
        "denominator",
        "context",
        "rounding_half_width",
        "scale"
      ],
      "additionalProperties": false
    },
    "source_object": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["text", "table", "figure", "equation", "section", "reference", "external", "parsed_artifact"]
        },
        "label": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] },
        "page": { "type": ["integer", "null"] },
        "page_label": { "type": ["string", "null"] },
        "section": { "type": ["string", "null"] },
        "text_quote": { "type": ["string", "null"] },
        "object_id": {"type": ["string", "null"]},
        "correspondence": {"type": ["string", "null"], "enum": ["text", "visual", "unresolved", "retrieved_external", "url_only", null]},
        "verification_note": {"type": ["string", "null"]},
        "url": { "type": ["string", "null"] }
      },
      "required": ["id", "type", "label", "path", "page", "page_label", "section", "text_quote", "url", "object_id", "correspondence", "verification_note"],
      "additionalProperties": false
    },
    "numeric_check": {
      "type": "object",
      "properties": {
        "reported_value": { "type": ["string", "number", "null"] },
        "expected_value": { "type": ["string", "number", "null"] },
        "method": { "type": ["string", "null"] },
        "inputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recomputation_notes": { "type": ["string", "null"] }
      },
      "required": ["reported_value", "expected_value", "method", "inputs", "recomputation_notes"],
      "additionalProperties": false
    },
    "claim_evidence_link": {
      "type": "object",
      "properties": {
        "claim_text": { "type": "string" },
        "source_object_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "relation": {
          "type": "string",
          "enum": ["supports", "contradicts", "partial", "cannot_verify"]
        },
        "note": { "type": ["string", "null"] }
      },
      "required": ["claim_text", "source_object_ids", "relation", "note"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "completion": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "enum": [
                1
              ]
            },
            "state": {
              "type": "string",
              "enum": [
                "complete",
                "not_applicable",
                "partial",
                "failed"
              ]
            },
            "scope_description": {
              "type": "string",
              "minLength": 1
            },
            "checks_completed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "missing_checks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "evidence_limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "version",
            "state",
            "scope_description",
            "checks_completed",
            "missing_checks",
            "evidence_limitations"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "source_object_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claim": {
            "type": [
              "string",
              "null"
            ]
          },
          "check_performed": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "checked_no_issue",
              "linked_finding",
              "cannot_verify",
              "not_applicable",
              "not_checked"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attempted": {
            "type": "boolean"
          },
          "importance": {
            "type": "string",
            "enum": [
              "central",
              "peripheral"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "exhaustive",
              "sampled"
            ]
          }
        },
        "required": [
          "item_id",
          "source_object_ids",
          "claim",
          "check_performed",
          "status",
          "reason",
          "finding_ids",
          "attempted",
          "importance",
          "scope"
        ],
        "additionalProperties": false
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "run_status": {
      "type": "string",
      "enum": ["ok", "partial", "cannot_verify", "failed"]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "finding_summary": {
            "type": "string",
            "minLength": 1
          },
          "issue_type": {
            "type": "string",
            "enum": [
              "manuscript_issue",
              "parser_artifact",
              "reference_integrity",
              "bibliography_maintenance",
              "copyedit_issue",
              "cannot_verify"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "location": {
            "type": "object",
            "properties": {
              "page": { "type": ["integer", "null"] },
              "page_label": { "type": ["string", "null"] },
              "section": { "type": ["string", "null"] },
              "text_quote": { "type": ["string", "null"] },
              "precision": {
                "type": "string",
                "enum": ["exact", "partial", "missing"]
              }
            },
            "required": ["page", "page_label", "section", "text_quote", "precision"],
            "additionalProperties": false
          },
          "claim_text": { "type": "string" },
          "assessment": {
            "type": "string",
            "enum": ["yes", "no", "partially", "cannot_verify"]
          },
          "cannot_verify_reason": { "type": ["string", "null"] },
          "evidence_summary": { "type": "string" },
          "source_objects": {
            "type": "array",
            "items": { "$ref": "#/$defs/source_object" }
          },
          "claim_evidence_links": {
            "type": "array",
            "items": { "$ref": "#/$defs/claim_evidence_link" }
          },
          "numeric_check": {
            "anyOf": [
              { "$ref": "#/$defs/typed_numeric_check" },
              { "type": "null" }
            ]
          },
          "suggested_fix": { "type": "string" }
        },
        "required": [
          "id",
          "category",
          "finding_summary",
          "issue_type",
          "severity",
          "confidence",
          "location",
          "claim_text",
          "assessment",
          "cannot_verify_reason",
          "evidence_summary",
          "source_objects",
          "claim_evidence_links",
          "numeric_check",
          "suggested_fix"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["reviewer", "paper_id", "run_status", "summary", "findings", "notes", "completion", "coverage"],
  "additionalProperties": false
}
